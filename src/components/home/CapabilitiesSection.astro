---
import { CAPABILITY_BLOCKS, COMPARISON_ROWS } from '../../data/site';
---
<section class="capabilities section-band">
  <div class="shell">
    <div class="capabilities__intro" data-reveal>
      <span class="eyebrow">WHAT WE DO</span>
      <h2 class="display-h2">A complete content-block pipeline for TYPO3 teams.</h2>
    </div>

    <div class="capabilities__list">
      {
        CAPABILITY_BLOCKS.map((block, idx) => (
          <article class="cap-row" data-reveal>
            <div class="cap-row__left">
              <div class="cap-row__sticky">
                <span class="eyebrow">0{idx + 1} / {block.stage}</span>
                <h3 class="display-h3 cap-row__title">{block.title}</h3>
                <div class="cap-row__pills">
                  {block.pills.map((pill) => <span class="pill-tag">{pill}</span>)}
                </div>
              </div>
            </div>

            <div class="cap-row__right">
              <div class="cap-row__icon" aria-hidden="true">
                <span>0{idx + 1}</span>
              </div>
              <p class="cap-row__desc">{block.summary}</p>
              <a href="/features" class="underline-link cap-row__more">
                Explore {block.title.toLowerCase()} →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- AEO / GEO Scannable Comparison Matrix -->
    <div class="compare-block" data-reveal>
      <div class="compare-block__head">
        <span class="eyebrow">T3ELEMENT VS MANUAL TYPO3</span>
        <h3 class="display-h3">Why TYPO3 agencies use a visual content block generator.</h3>
      </div>

      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Workflow Dimension</th>
              <th>T3element Builder</th>
              <th>Manual TYPO3 Setup</th>
            </tr>
          </thead>
          <tbody>
            {
              COMPARISON_ROWS.map((row) => (
                <tr>
                  <td><strong>{row.metric}</strong></td>
                  <td class="compare-table__t3">{row.t3}</td>
                  <td class="compare-table__manual">{row.manual}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .capabilities {
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .capabilities__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
    padding-bottom: 3rem;
  }

  .capabilities__list {
    display: flex;
    flex-direction: column;
  }

  .cap-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-hairline);
  }

  @media (min-width: 900px) {
    .cap-row {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    .cap-row__sticky {
      position: sticky;
      top: 3rem;
    }
  }

  .cap-row__title {
    margin-top: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .cap-row__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cap-row__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .cap-row__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-primary);
  }

  .cap-row__desc {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .cap-row__more {
    align-self: flex-start;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .compare-block {
    margin-top: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .compare-block__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .compare-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border-hairline);
    border-radius: 0.5rem;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.95rem 1.2rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .compare-table tr:last-child td {
    border-bottom: none;
  }

  .compare-table th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    background: var(--bg-muted);
  }

  .compare-table__t3 {
    font-weight: 600;
    color: var(--ink-primary);
  }

  .compare-table__manual {
    color: var(--ink-secondary);
  }
</style>
