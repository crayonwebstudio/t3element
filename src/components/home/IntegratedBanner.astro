---
import { SITE } from '../../data/site';
---
<section class="integrated-banner section-band">
  <div class="shell">
    <div class="integrated-card" data-reveal>
      <span class="pill-tag pill-tag--accent">
        <span class="orange-dot" aria-hidden="true"></span>
        INTEGRATED TYPO3 EXTENSION
      </span>

      <h2 class="display-h2 integrated-card__title">
        T3element - A TYPO3 CMS Custom Content Block Integrated Solution
      </h2>

      <p class="integrated-card__sub">
        Try T3element in the TYPO3 CMS Integrated extension for a visual custom content element builder. Cool! Just a click and your custom element package is ready to work.
      </p>

      <div class="integrated-card__cta">
        <a href={SITE.terUrl} target="_blank" rel="noopener noreferrer" class="pill-btn integrated-btn">
          <span>Available Now</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>

      <div class="integrated-card__also">
        <span class="eyebrow">ALSO AVAILABLE ON</span>
        <div class="also-icons">
          <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="also-link" aria-label="GitHub Repository" title="GitHub">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
            </svg>
            <span>GitHub</span>
          </a>

          <a href={SITE.terUrl} target="_blank" rel="noopener noreferrer" class="also-link" aria-label="TYPO3 Extension Repository" title="TYPO3 TER">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.2 14.3c-.4.1-.7.2-1.1.2-2.7 0-5.8-5.2-5.8-8.7 0-1.2.3-1.9.8-2.3-3.5.4-7.6 1.7-8.9 3.6-.3.4-.4 1-.4 1.8 0 4.8 4.9 12.6 8.8 12.6 2.1 0 4.8-3 6.6-7.2ZM15.5 2.5c-2.5 0-3.3.6-3.3 2.3 0 2.7 2.4 7.3 4.3 7.3 1.6 0 3.7-3.4 3.7-6.3 0-2.5-1.2-3.3-4.7-3.3Z"/>
            </svg>
            <span>TYPO3 TER</span>
          </a>

          <a href={SITE.packagistUrl} target="_blank" rel="noopener noreferrer" class="also-link" aria-label="Packagist Composer Package" title="Packagist">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2 3 6.5v11L12 22l9-4.5v-11L12 2Zm0 2.3 6.5 3.2L12 10.7 5.5 7.5 12 4.3ZM5 9.2l6 3v7.3l-6-3V9.2Zm14 7.3-6 3v-7.3l6-3v7.3Z"/>
            </svg>
            <span>Packagist</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .integrated-banner {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .integrated-card {
    background: var(--bg-dark);
    color: var(--ink-inverse);
    border-radius: 1rem;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.35rem;
  }

  .integrated-card .pill-tag--accent {
    background: rgba(247, 147, 30, 0.16);
    color: var(--accent-orange);
    border-color: rgba(247, 147, 30, 0.45);
  }

  .integrated-card__title {
    max-width: 24ch;
    color: #ffffff;
  }

  .integrated-card__sub {
    margin: 0;
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .integrated-btn {
    background: #ffffff;
    border-color: #ffffff;
    color: #111111;
    padding: 0.9rem 2rem;
  }

  .integrated-btn:hover {
    background: var(--accent-orange);
    border-color: var(--accent-orange);
    color: #111111;
  }

  .integrated-card__also {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .integrated-card__also .eyebrow {
    color: rgba(255, 255, 255, 0.55);
  }

  .also-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .also-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.82rem;
    font-weight: 500;
    transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  .also-link:hover {
    border-color: var(--accent-orange);
    background: rgba(247, 147, 30, 0.15);
    color: #ffffff;
  }
</style>
