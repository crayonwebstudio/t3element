---
import { HERO_BADGES, SITE } from '../../data/site';
---
<section class="startscreen">
  <div class="shell">
    <div class="hairline-grid-2 startscreen__grid">
      <span class="crosshair crosshair--tl" aria-hidden="true"></span>
      <span class="crosshair crosshair--tc" aria-hidden="true"></span>
      <span class="crosshair crosshair--tr" aria-hidden="true"></span>
      <span class="crosshair crosshair--bl" aria-hidden="true"></span>
      <span class="crosshair crosshair--bc" aria-hidden="true"></span>
      <span class="crosshair crosshair--br" aria-hidden="true"></span>

      <!-- Left: Kinetic Content-Block Assembly Pipeline Infographic -->
      <div class="startscreen__left">
        <div class="infographic-header">
          <span class="eyebrow">LIVE BUILD ARCHITECTURE</span>
          <span class="infographic-badge">
            <span class="orange-dot pulse-dot" aria-hidden="true"></span>
            <span id="pipeline-status-text">Compiling TCA Schema…</span>
          </span>
        </div>

        <div class="pipeline" id="hero-pipeline">
          <!-- Stage 1: Visual Field Inputs -->
          <div class="pipeline__fields">
            <button type="button" class="field-node is-active" data-field="tca">
              <span class="field-node__num">01</span>
              <span class="field-node__name">Title &amp; Text</span>
              <span class="field-node__type">Input</span>
            </button>
            <button type="button" class="field-node" data-field="rte">
              <span class="field-node__num">02</span>
              <span class="field-node__name">Rich Text</span>
              <span class="field-node__type">RTE</span>
            </button>
            <button type="button" class="field-node" data-field="fal">
              <span class="field-node__num">03</span>
              <span class="field-node__name">Media / Image</span>
              <span class="field-node__type">FAL</span>
            </button>
            <button type="button" class="field-node" data-field="irre">
              <span class="field-node__num">04</span>
              <span class="field-node__name">Repeatable</span>
              <span class="field-node__type">IRRE</span>
            </button>
          </div>

          <!-- Animated SVG Signal Conduits -->
          <svg class="pipeline__conduits" viewBox="0 0 480 230" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <path id="path-1" d="M 60 0 C 60 120, 240 100, 240 230" fill="none" stroke="rgba(34,34,34,0.22)" stroke-width="1.3" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
            <path id="path-2" d="M 180 0 C 180 120, 240 100, 240 230" fill="none" stroke="rgba(34,34,34,0.22)" stroke-width="1.3" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
            <path id="path-3" d="M 300 0 C 300 120, 240 100, 240 230" fill="none" stroke="rgba(34,34,34,0.22)" stroke-width="1.3" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
            <path id="path-4" d="M 420 0 C 420 120, 240 100, 240 230" fill="none" stroke="rgba(34,34,34,0.22)" stroke-width="1.3" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />

            <!-- Moving Orange Data Packets (1:1 aspect ratio, zero distortion) -->
            <circle r="4" fill="#F7931E">
              <animateMotion dur="2.2s" repeatCount="indefinite" begin="0s">
                <mpath href="#path-1" />
              </animateMotion>
            </circle>
            <circle r="3.5" fill="#222222">
              <animateMotion dur="2.2s" repeatCount="indefinite" begin="0.55s">
                <mpath href="#path-2" />
              </animateMotion>
            </circle>
            <circle r="4" fill="#F7931E">
              <animateMotion dur="2.2s" repeatCount="indefinite" begin="1.1s">
                <mpath href="#path-3" />
              </animateMotion>
            </circle>
            <circle r="3.5" fill="#222222">
              <animateMotion dur="2.2s" repeatCount="indefinite" begin="1.65s">
                <mpath href="#path-4" />
              </animateMotion>
            </circle>
          </svg>

          <!-- Stage 2: T3element Compiler Hub -->
          <div class="pipeline__hub">
            <div class="hub-ring">
              <svg viewBox="0 0 64 64" class="hub-ring__svg" aria-hidden="true">
                <circle cx="32" cy="32" r="28" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="2" />
                <circle cx="32" cy="32" r="28" fill="none" stroke="#F7931E" stroke-width="2.2" stroke-dasharray="60 120" stroke-linecap="round" class="hub-spinner" />
              </svg>
              <img src="/logos/t3-mark-white.png" alt="t3" class="hub-ring__logo" width="18" height="24" />
            </div>

            <div class="hub-info">
              <span class="hub-info__label">T3ELEMENT COMPILER</span>
              <strong class="hub-info__title" id="hub-active-output">Configuration/TCA/Overrides/tt_content.php</strong>
            </div>

            <span class="hub-badge">v13 &amp; v14</span>
          </div>

          <!-- Stage 3: Output Tree & Velocity Bar -->
          <div class="pipeline__output">
            <div class="output-files">
              <div class="output-file is-highlighted" data-file="tca">
                <span class="output-file__dot"></span>
                <code>TCA / tt_content.php</code>
                <span class="output-file__tag">Auto</span>
              </div>
              <div class="output-file" data-file="rte">
                <span class="output-file__dot"></span>
                <code>Templates/Block.html</code>
                <span class="output-file__tag">Fluid</span>
              </div>
              <div class="output-file" data-file="fal">
                <span class="output-file__dot"></span>
                <code>ext_emconf.php</code>
                <span class="output-file__tag">ZIP</span>
              </div>
            </div>

            <div class="velocity-compare">
              <div class="velocity-row">
                <span class="velocity-row__label">Manual TYPO3</span>
                <div class="velocity-track"><div class="velocity-fill velocity-fill--manual"></div></div>
                <span class="velocity-row__time">~3 hrs</span>
              </div>
              <div class="velocity-row">
                <span class="velocity-row__label"><strong>T3element</strong></span>
                <div class="velocity-track"><div class="velocity-fill velocity-fill--t3"></div></div>
                <span class="velocity-row__time"><strong>~4 min</strong></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Display H1 + Pills + Demo Form -->
      <div class="startscreen__right">
        <div class="startscreen__eyebrow">
          <span class="pill-tag pill-tag--accent">
            <span class="orange-dot" aria-hidden="true"></span>
            SUPPORTED FOR TYPO3 V13 &amp; V14
          </span>
        </div>

        <h1 class="display-h1 startscreen__title">
          TYPO3 Custom Content Blocks, built in minutes.
        </h1>

        <p class="startscreen__sub">
          Generate a ready-to-install TYPO3 CMS starter package with drag-and-drop fields, validations, and Fluid templates, without deep TypoScript knowledge.
        </p>

        <div class="startscreen__badges">
          {HERO_BADGES.slice(1).map((b, i) => (
            <span class="pill-tag badge-ico-pill">
              {i === 0 && (
                <svg class="badge-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.78A6 6 0 0 0 4.5 12.5 3.5 3.5 0 0 0 6 19h11.5Z" />
                </svg>
              )}
              {i === 1 && (
                <svg class="badge-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
                </svg>
              )}
              {i === 2 && (
                <svg class="badge-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 6h10" /><path d="M18 6h2" /><circle cx="16" cy="6" r="2" />
                  <path d="M4 18h4" /><path d="M12 18h8" /><circle cx="10" cy="18" r="2" />
                  <path d="M4 12h2" /><path d="M10 12h10" /><circle cx="8" cy="12" r="2" />
                </svg>
              )}
              {i === 3 && (
                <svg class="badge-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 13 9 5 9-5" />
                </svg>
              )}
              <span>{b}</span>
            </span>
          ))}
        </div>

        <form class="hero-demo-form" id="hero-demo-form">
          <input type="text" name="company_url" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
          <input
            type="email"
            name="email"
            required
            placeholder="Your work email"
            class="line-input hero-demo-input"
            aria-label="Work email for demo"
          />
          <div
            class="cf-turnstile"
            data-sitekey="0x4AAAAAAGIk6K7rP_deyykW"
            data-action="demo"
            data-theme="light"
          ></div>
          <div class="hero-demo-actions">
            <button type="submit" class="pill-btn pill-btn--dark">
              <span>Get a demo</span>
              <span class="btn-arrow">→</span>
            </button>
            <a href={SITE.appRegisterUrl} target="_blank" rel="noopener noreferrer" class="pill-btn">
              <span>Open Standalone App</span>
              <span class="btn-arrow">→</span>
            </a>
          </div>
          <p class="hero-demo-status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .startscreen {
    padding-top: 0;
  }

  .startscreen__left,
  .startscreen__right {
    padding: clamp(1.5rem, 4vw, 3.75rem);
    min-width: 0;
    max-width: 100%;
  }

  .startscreen__title {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .startscreen__left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 1.5rem;
    background: linear-gradient(180deg, rgba(247, 247, 247, 0.45) 0%, rgba(255, 255, 255, 0) 100%);
  }

  .infographic-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .infographic-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-secondary);
  }

  .pulse-dot {
    animation: pulseLive 1.4s ease-in-out infinite;
  }

  @keyframes pulseLive {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.45); opacity: 0.55; }
  }

  .pipeline {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .pipeline__fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
  }

  @media (min-width: 520px) {
    .pipeline__fields {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .field-node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    padding: 0.7rem 0.75rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 0.5rem;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.25s ease, transform 0.25s var(--ease-expo), background-color 0.25s ease;
  }

  .field-node:hover {
    border-color: var(--ink-primary);
    transform: translateY(-2px);
  }

  .field-node.is-active {
    border-color: var(--ink-primary);
    box-shadow: inset 0 0 0 1px var(--ink-primary);
  }

  .field-node.is-active .field-node__num {
    color: var(--accent-orange);
  }

  .field-node__num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .field-node__name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-primary);
    line-height: 1.2;
  }

  .field-node__type {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-muted);
  }

  .pipeline__conduits {
    width: 100%;
    flex: 1;
    min-height: 165px;
    display: block;
  }

  .pipeline__hub {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-dark);
    color: var(--ink-inverse);
    border-radius: 0.65rem;
  }

  .hub-ring {
    position: relative;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hub-ring__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hub-spinner {
    transform-origin: center;
    animation: spinHub 2.8s linear infinite;
  }

  @keyframes spinHub {
    to { transform: rotate(360deg); }
  }

  .hub-ring__logo {
    width: 16px;
    height: auto;
  }

  .hub-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .hub-info__label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55);
  }

  .hub-info__title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hub-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(247, 147, 30, 0.16);
    color: var(--accent-orange);
    white-space: nowrap;
  }

  .pipeline__output {
    margin-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .output-files {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
  }

  .output-file {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.9rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 0.45rem;
    font-size: 0.78rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .output-file.is-highlighted {
    border-color: var(--accent-orange);
    background: var(--accent-orange-soft);
  }

  .output-file__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-muted);
    flex-shrink: 0;
  }

  .output-file.is-highlighted .output-file__dot {
    background: var(--accent-orange);
  }

  .output-file code {
    font-family: var(--font-mono);
    flex: 1;
    color: var(--ink-primary);
  }

  .output-file__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .velocity-compare {
    padding: 0.85rem 1rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .velocity-row {
    display: grid;
    grid-template-columns: 92px 1fr 48px;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .velocity-row__label {
    color: var(--ink-secondary);
  }

  .velocity-row__time {
    font-family: var(--font-mono);
    text-align: right;
    color: var(--ink-secondary);
  }

  .velocity-track {
    height: 6px;
    background: var(--bg-muted);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .velocity-fill {
    height: 100%;
    border-radius: var(--radius-pill);
  }

  .velocity-fill--manual {
    width: 92%;
    background: var(--border-strong);
    animation: growManual 1.1s var(--ease-expo) forwards;
  }

  .velocity-fill--t3 {
    width: 14%;
    background: var(--accent-orange);
    animation: growT3 1.1s var(--ease-expo) forwards;
  }

  @keyframes growManual {
    from { width: 0; }
    to { width: 92%; }
  }

  @keyframes growT3 {
    from { width: 0; }
    to { width: 14%; }
  }

  .startscreen__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  .startscreen__sub {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-secondary);
    max-width: 52ch;
    line-height: 1.55;
  }

  .badge-ico-pill {
    gap: 0.45rem;
  }

  .badge-ico {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--accent-orange);
  }

  .startscreen__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-demo-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .hero-demo-status {
    margin: 0;
    font-size: 0.84rem;
    color: var(--ink-secondary);
    min-height: 1.2em;
  }

  .human-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    cursor: pointer;
  }

  .human-check input {
    accent-color: var(--ink-primary);
    width: 14px;
    height: 14px;
  }
</style>

<script>
  import { CRM_ENDPOINTS, postToCrm } from '../../lib/crm';

  const form = document.getElementById('hero-demo-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.hero-demo-status');
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (String(fd.get('company_url') || '').trim() !== '') return;

      const token = String(fd.get('cf-turnstile-response') || '');
      if (!token) {
        if (status) status.textContent = 'Please complete the Turnstile security check.';
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (status) status.textContent = 'Requesting demo...';

      const result = await postToCrm(CRM_ENDPOINTS.demo, {
        email: String(fd.get('email') || ''),
        'cf-turnstile-response': token,
      });

      const widgetEl = form.querySelector('.cf-turnstile');
      if (widgetEl && (window as any).turnstile) {
        (window as any).turnstile.reset(widgetEl);
      }

      if (status) {
        status.textContent =
          result.code === 'success'
            ? 'Demo request received! We will send your walkthrough link shortly.'
            : result.message;
      }
      if (result.ok) form.reset();
      if (submitBtn) submitBtn.disabled = false;
    });
  }
</script>

<script is:inline>
  (function () {
    // Kinetic Pipeline Auto-Cycle & Interactive Selection
    const nodes = document.querySelectorAll('.field-node');
    const files = document.querySelectorAll('.output-file');
    const statusText = document.getElementById('pipeline-status-text');
    const hubOutput = document.getElementById('hub-active-output');
    if (!nodes.length) return;

    const map = {
      tca: { status: 'Compiling TCA Schema…', path: 'Configuration/TCA/Overrides/tt_content.php', file: 'tca' },
      rte: { status: 'Binding Fluid Markup…', path: 'Resources/Private/Templates/Block.html', file: 'rte' },
      fal: { status: 'Mapping FAL Media…', path: 'ext_emconf.php + FAL Relations', file: 'fal' },
      irre: { status: 'Packing IRRE Repeaters…', path: 'Configuration/TCA/tx_t3element_items.php', file: 'tca' },
    };

    let currentIdx = 0;
    let timer;

    function activate(key) {
      const info = map[key] || map.tca;
      nodes.forEach((n) => n.classList.toggle('is-active', n.getAttribute('data-field') === key));
      files.forEach((f) => f.classList.toggle('is-highlighted', f.getAttribute('data-file') === info.file));
      if (statusText) statusText.textContent = info.status;
      if (hubOutput) hubOutput.textContent = info.path;
    }

    function startCycle() {
      clearInterval(timer);
      timer = setInterval(() => {
        currentIdx = (currentIdx + 1) % nodes.length;
        const key = nodes[currentIdx].getAttribute('data-field');
        if (key) activate(key);
      }, 2600);
    }

    nodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        currentIdx = idx;
        const key = node.getAttribute('data-field');
        if (key) activate(key);
        startCycle();
      });
    });

    startCycle();
  })();
</script>
