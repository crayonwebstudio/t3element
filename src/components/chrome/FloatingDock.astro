---
import { DOCK_NAV, SITE } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---
<nav class="dock-wrap" aria-label="Primary Navigation">
  <div class="dock">
    <a
      href="/"
      class:list={['dock__home', { 'is-active': currentPath === '/' }]}
      aria-label="Home"
      title="Home"
    >
      <img src="/logos/t3-mark-white.png" alt="t3" width="18" height="24" />
    </a>

    <div class="dock__links" id="dock-links">
      {
        DOCK_NAV.map((item) => {
          const active = currentPath === item.href || currentPath === `${item.href}/`;
          return (
            <a href={item.href} class:list={['dock__link', { 'is-active': active }]}>
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </div>

    <a href={SITE.meetingUrl} target="_blank" rel="noopener noreferrer" class="dock__cta">
      <span>Book Audit</span>
      <span class="dock__cta-arrow">→</span>
    </a>

    <button
      type="button"
      class="dock__mobile-toggle"
      id="dock-mobile-toggle"
      aria-expanded="false"
      aria-controls="dock-mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <span>Menu</span>
    </button>
  </div>

  <div class="dock-mobile-menu" id="dock-mobile-menu" hidden>
    {
      DOCK_NAV.map((item) => (
        <a href={item.href} class="dock-mobile-menu__link">
          {item.label}
        </a>
      ))
    }
    <a href={SITE.appLoginUrl} target="_blank" rel="noopener noreferrer" class="dock-mobile-menu__link">
      Login →
    </a>
  </div>
</nav>

<style>
  .dock-wrap {
    position: fixed;
    bottom: 1.35rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
  }

  .dock {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--bg-dock);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
    color: var(--ink-inverse);
  }

  .dock__home {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    transition: background-color 0.25s ease, transform 0.25s var(--ease-expo);
    flex-shrink: 0;
  }

  .dock__home img {
    width: 16px;
    height: auto;
  }

  .dock__home:hover,
  .dock__home.is-active {
    background: rgba(255, 255, 255, 0.16);
    transform: scale(0.95);
  }

  .dock__links {
    display: none;
    align-items: center;
    gap: 0.2rem;
    padding-inline: 0.25rem;
  }

  .dock__link {
    position: relative;
    padding: 0.62rem 0.95rem;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.2s ease, background-color 0.25s ease, transform 0.25s var(--ease-expo);
    white-space: nowrap;
  }

  .dock__link:hover {
    color: #ffffff;
    background: var(--bg-dock-hover);
    transform: scale(0.95);
  }

  .dock__link.is-active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.14);
  }

  .dock__link.is-active::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-orange);
  }

  .dock__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-pill);
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .dock__cta:hover {
    background: var(--accent-orange);
    border-color: var(--accent-orange);
    color: #111111;
  }

  .dock__cta-arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-expo);
  }

  .dock__cta:hover .dock__cta-arrow {
    transform: translateX(3px);
  }

  .dock__mobile-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-pill);
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .dock-mobile-menu {
    position: absolute;
    bottom: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(300px, calc(100vw - 2rem));
    background: var(--bg-dark);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1.25rem;
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.32);
  }

  .dock-mobile-menu[hidden] {
    display: none;
  }

  .dock-mobile-menu__link {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .dock-mobile-menu__link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .dock__links {
      display: flex;
    }
    .dock__mobile-toggle {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('dock-mobile-toggle');
    const menu = document.getElementById('dock-mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });
  })();
</script>
