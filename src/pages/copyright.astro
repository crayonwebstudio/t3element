---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const items = [
  {
    id: '01',
    title: 'Ownership',
    body: `${SITE.copyright} All original website copy, UI designs, diagrams, documentation, and the t3element™ wordmark and logo marks are the intellectual property of T3element.`,
  },
  {
    id: '02',
    title: 'TYPO3 Trademarks & Open Source',
    body: 'TYPO3 is a registered trademark of the TYPO3 Association. T3element is an independent tool built for the TYPO3 CMS ecosystem and is not officially affiliated with or endorsed by the TYPO3 Association.',
  },
  {
    id: '03',
    title: 'Generated Extension Code',
    body: 'Extension packages generated by T3element for your TYPO3 projects may be freely used, modified, and distributed under GPL-compatible TYPO3 extension terms.',
  },
];
---
<BaseLayout title="Copyright - T3element" description="Copyright and trademark notices for T3element.">
  <section class="page-hero">
    <div class="shell">
      <span class="eyebrow">LEGAL / COPYRIGHT</span>
      <h1 class="display-h1 page-hero__title">Copyright Notice.</h1>
      <p class="page-hero__sub">{SITE.copyright}</p>
    </div>
  </section>

  <section class="editorial-section section-band">
    <div class="shell">
      <div class="editorial-list">
        {
          items.map((item) => (
            <article class="editorial-row">
              <div class="editorial-row__left">
                <span class="editorial-num">{item.id}</span>
                <h2 class="display-h3">{item.title}</h2>
              </div>
              <div class="editorial-row__right">
                <p>{item.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .page-hero__title { margin-top: 0.75rem; }
  .page-hero__sub { margin: 1rem 0 0; color: var(--ink-secondary); max-width: 54ch; }
  .editorial-section { padding-bottom: clamp(4rem, 7vw, 6rem); }
  .editorial-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-hairline);
  }
  @media (min-width: 820px) {
    .editorial-row {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
  }
  .editorial-row__left { display: flex; flex-direction: column; gap: 0.5rem; }
  .editorial-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-orange); font-weight: 600; }
  .editorial-row__right p { margin: 0; color: var(--ink-secondary); line-height: 1.7; font-size: 0.98rem; }
</style>
